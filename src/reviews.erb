---
layout: listing
title: Things I've reviewed
---

<%
book_reviews = site.collections["books"].resources.select { |b| b.data.has_review }
multi_reviews = (site.collections["reviews"]&.resources || [])
all_reviews = (book_reviews + multi_reviews).sort_by { |post| time_for(post.data.date) }.reverse
%>
<ul>
  <% all_reviews.each do |post| %>
  <li>
    <a class="title" href="<%= post.relative_url %>">
      <%= post.data.title %>
    </a>
    <time datetime="<%= time_for(post.data.date).xmlschema %>">
      <%= time_for(post.data.date).strftime("%Y-%m-%d") %>
    </time>
  </li>
  <% end %>
</ul>
