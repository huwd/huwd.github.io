---
layout: listing
title: Things I've reviewed
---

<ul>
  <% all_reviews.each do |post| %>
  <li>
    <a class="title" href="<%= post.relative_url %>">
      <%= post.data.title %>
    </a>
    <time datetime="<%= time_for(post.data.date).xmlschema %>">
      <%= time_for(post.data.date).strftime("%Y-%m-%d") %>
    </time>
  </li>
  <% end %>
</ul>
