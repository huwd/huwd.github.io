---
layout: default
---

<article class="post">
  <h1><%= data.title %></h1>

  <% if data.rating %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org/",
      "@type" => "Review",
      "itemReviewed" => {
        "@type" => "Book",
        "name" => data.title,
        "author" => Array(data.authors).map { |name| { "@type" => "Person", "name" => name } },
      },
      "reviewRating" => {
        "@type" => "Rating",
        "ratingValue" => data.rating,
        "bestRating" => 5,
        "worstRating" => 1,
      },
      "author" => { "@type" => "Person", "name" => "Huw Diprose" },
      "datePublished" => time_for(data.date).xmlschema,
    }.to_json.gsub("</", '<\/').html_safe %>
  </script>
  <% end %>

  <% if data.date_finished %>
  <%= yield %>
  <span class="meta">
    Read:
    <% if data.date_started %>
      <time datetime="<%= time_for(data.date_started).xmlschema %>"><%= time_for(data.date_started).strftime("%-d %B %Y") %></time>
    <% end %>
    <% if data.date_finished %>
      &ndash;
      <time datetime="<%= time_for(data.date_finished).xmlschema %>"><%= time_for(data.date_finished).strftime("%-d %B %Y") %></time>
    <% end %>
    <br>
    Reviewed:
    <time datetime="<%= time_for(data.date).xmlschema %>"><%= time_for(data.date).strftime("%-d %B %Y") %></time>
    <% if site.metadata.signature %> | <%= site.metadata.signature %> <% end %>
  </span>
  <% else %>
  <p class="meta">
    Read:
    <% if data.date_started %>
      <time datetime="<%= time_for(data.date_started).xmlschema %>"><%= time_for(data.date_started).strftime("%-d %B %Y") %></time>
    <% end %>
    <% if data.date %>
      &ndash;
      <time datetime="<%= time_for(data.date).xmlschema %>"><%= time_for(data.date).strftime("%-d %B %Y") %></time>
    <% end %>
  </p>
  <% end %>

  <%= render "book_links" %>
</article>
