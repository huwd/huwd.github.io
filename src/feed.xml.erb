---
layout: none
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title><%= xml_escape site.metadata.title %></title>
  <subtitle><%= xml_escape site.metadata.description %></subtitle>
  <link rel="self" type="application/atom+xml" href="<%= absolute_url "/feed.xml" %>" />
  <link rel="alternate" type="text/html" href="<%= absolute_url "/" %>" />
  <id><%= absolute_url "/" %></id>
  <% items = (all_reviews + all_weeknotes + all_blog_posts).sort_by { |item| time_for(item.data.date) }.reverse %>
  <updated><%= (items.first ? time_for(items.first.data.date) : site.time).xmlschema %></updated>
  <author>
    <name><%= xml_escape site.metadata.author.name %></name>
    <email><%= site.metadata.email %></email>
  </author>

  <% items.each do |item| %>
  <entry>
    <title><%= xml_escape item.data.title %></title>
    <link rel="alternate" type="text/html" href="<%= item.absolute_url %>" />
    <id><%= item.absolute_url %></id>
    <published><%= time_for(item.data.date).xmlschema %></published>
    <updated><%= time_for(item.data.date).xmlschema %></updated>
    <% if item.data.description %>
    <summary type="text"><%= xml_escape item.data.description %></summary>
    <% end %>
  </entry>
  <% end %>
</feed>
