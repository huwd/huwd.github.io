<header role="banner">
  <nav class="site-nav" role="navigation">
    <ul>
      <li><%= metadata.name %></li>
      <% navigation.links.each do |item| %>
        <li><a href="<%= item.url %>"<% if item.url == resource.relative_url %> class="active"<% end %>><%= item.title %></a></li>
      <% end %>
    </ul>
  </nav>
</header>
